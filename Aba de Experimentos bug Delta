function GetAllServers(placeId)
    local servers = {}

    pcall(function()
        local url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"
        local data = HttpService:JSONDecode(game:HttpGet(url))

        if data and data.data then
            for _, server in ipairs(data.data) do
                table.insert(servers, server)
            end
        end

        local cursor = data.nextPageCursor
        while cursor and #servers < 100 do
            local nextUrl = url .. "&cursor=" .. cursor
            local nextData = HttpService:JSONDecode(game:HttpGet(nextUrl))
            if nextData and nextData.data then
                for _, server in ipairs(nextData.data) do
                    table.insert(servers, server)
                end
            end
            cursor = nextData.nextPageCursor
        end
    end)

    return servers
end

function FilterServers(servers)
    local filtered = {}
    
    for _, server in ipairs(servers) do
        local playing = server.playing or 0
        local maxPlayers = server.maxPlayers or 6
        local vacancies = maxPlayers - playing
        local serverId = server.id or ""
        local ping = server.ping or 999
        
        local passesFilter = true
        
        if filterMode == "almostFull" then
            passesFilter = (vacancies <= 5 and vacancies > 0)
        elseif filterMode == "lowPing" then
            passesFilter = (ping < 80)
        end
        
        if searchTerm ~= "" and passesFilter then
            local term = searchTerm:lower()
            passesFilter = (
                serverId:lower():find(term) or
                tostring(playing):find(term) or
                ("vagas"):find(term) and vacancies > 0 or
                ("lotado"):find(term) and vacancies == 0
            )
        end
        
        if passesFilter then
            table.insert(filtered, server)
        end
    end
    
    return filtered
end

function UpdateServerList(servers)
    for _, frame in ipairs(serverFrames) do
        frame:Destroy()
    end
    serverFrames = {}

    local filteredServers = FilterServers(servers)
    
    if #filteredServers == 0 then
        ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
        TitleText.Text = "JOIN SPWNCUB [0/" .. #servers .. "]"
        
        -- Mensagem quando não encontra resultados
        Create("TextLabel", ScrollContainer, {
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundTransparency = 1,
            Font = Enum.Font.Arcade,
            Text = "Nenhum servidor encontrado",
            TextColor3 = Color3.fromRGB(150, 150, 150),
            TextSize = 12,
            ZIndex = 5
        })
        return
    end

    table.sort(filteredServers, function(a, b)
        return (a.ping or 999) < (b.ping or 999)
    end)

    if #filteredServers > 50 then
        for i = #filteredServers, 51, -1 do
            table.remove(filteredServers, i)
        end
    end

    for i, server in ipairs(filteredServers) do
        CreateServerSlot(server, i)
    end

    ScrollContainer.CanvasSize = UDim2.new(0, 0, 0, #serverFrames * 92)
    TitleText.Text = "JOIN SPWNCUB [" .. #filteredServers .. "/" .. #servers .. "]"
end

function RefreshServers()
    if isRefreshing then return end
    isRefreshing = true
    
    TitleText.Text = "JOIN SPWNCUB [CARREGANDO...]"

    task.spawn(function()
        UpdateServerList(GetAllServers(game.PlaceId))
        isRefreshing = false
    end)
end

local function makeDraggable(obj)
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local isDragging = false

    obj.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            isDragging = false
            dragStart = input.Position
            startPos = obj.Position
        end
    end)

    obj.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
            isDragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or 
                         input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if not isDragging then
                isDragging = true
            end
            obj.Position = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end)
end

