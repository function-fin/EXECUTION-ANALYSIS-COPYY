--====================================
-- 4. RADAR HEARTBEAT
--====================================
RunService.Heartbeat:Connect(function()
    if Config.Running and Config.Ativo and Config.LotePos then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= Players.LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (Config.LotePos - p.Character.HumanoidRootPart.Position).Magnitude

                local isMansion = (Config.LoteNome:find("Mansion") or Config.LoteNome:find("01"))
                local threshold = isMansion and 300 or Config.DistanciaDefesa

                if dist < threshold then 
                    ExecutarBan(p) 
                end
            end
        end
    end
end)