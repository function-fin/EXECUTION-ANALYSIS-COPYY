function CreateServerSlot(server, index)
    local Slot = Create("Frame", ScrollContainer, {
        Size = UDim2.new(1, 0, 0, 87), 
        BackgroundTransparency = 1, 
        ZIndex = 5,
        LayoutOrder = index
    })

    local playing = server.playing or 0
    local maxPlayers = server.maxPlayers or 6
    local ping = server.ping or math.random(20, 150)
    local fps = ping > 0 and math.min(math.floor(1000 / ping), 60) or 0
    local serverId = server.id or "N/A"
    
    -- Destaque do servidor atual
    local isCurrentServer = (serverId == currentServerId)
    Slot:SetAttribute("IsCurrentServer", isCurrentServer)
    
    if isCurrentServer then
        -- Fundo destacado
        local highlightBg = Create("Frame", Slot, {
            Name = "CurrentHighlight",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundColor3 = Color3.fromRGB(0, 100, 0),
            BackgroundTransparency = 0.75,
            BorderSizePixel = 0,
            ZIndex = 4
        }, 8)
        
        -- Badge "VOCÊ ESTÁ AQUI"
        local badge = Create("TextLabel", Slot, {
            Name = "CurrentBadge",
            Size = UDim2.new(0, 110, 0, 18),
            Position = UDim2.new(0, 9, 0, 2),
            BackgroundColor3 = Color3.fromRGB(0, 255, 100),
            BackgroundTransparency = 0.2,
            Font = Enum.Font.Arcade,
            Text = "⭐ VOCÊ ESTÁ AQUI",
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextSize = 9,
            ZIndex = 7
        }, 6, { Color = Color3.fromRGB(0, 255, 100), Thickness = 1 })
        
        -- Animação sutil de pulso
        task.spawn(function()
            while badge and badge.Parent do
                for i = 1, 10 do
                    badge.BackgroundTransparency = 0.2 + (i * 0.05)
                    task.wait(0.05)
                end
                for i = 10, 1, -1 do
                    badge.BackgroundTransparency = 0.2 + (i * 0.05)
                    task.wait(0.05)
                end
            end
        end)
    end

    local pingColor
    if ping < 60 then
        pingColor = Color3.fromRGB(0, 255, 100)
    elseif ping < 120 then
