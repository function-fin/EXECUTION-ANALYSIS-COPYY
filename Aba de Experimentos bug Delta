--====================================
-- 3. LÓGICA DA LISTA E PESQUISA
--====================================
local function UpdateList()
    if not Config.Running then return end
    for _, v in pairs(Scroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Players.LocalPlayer then
            local pName = p.Name:lower()
            local pDisplay = p.DisplayName:lower()
            local filter = Config.SearchFilter:lower()

            -- Aplicação do filtro da Barra de Pesquisa
            if filter == "" or pName:find(filter) or pDisplay:find(filter) then
                local pBtn = Instance.new("TextButton", Scroll)
                pBtn.Size = UDim2.new(0.95, 0, 0, 36)
                pBtn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
                pBtn.Font = Enum.Font.Arcade; pBtn.TextSize = 15; pBtn.TextColor3 = Color3.new(1,1,1)
                pBtn.BackgroundColor3 = table.find(Config.Whitelist, p.Name) and Color3.fromRGB(0, 120, 0) or Color3.fromRGB(28, 28, 28)
                pBtn.ZIndex = 3
                Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 6)
                
                local btnStroke = Instance.new("UIStroke", pBtn)
                btnStroke.Thickness = 1
                btnStroke.Color = Color3.fromRGB(60, 60, 60)

                pBtn.MouseButton1Click:Connect(function()
                    local index = table.find(Config.Whitelist, p.Name)
                    if index then 
                        table.remove(Config.Whitelist, index)
                        pBtn.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
                    else 
                        table.insert(Config.Whitelist, p.Name)
                        pBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 0) 
                    end
                end)
            end
        end
    end
    Scroll.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 10)
end

