    local btn = Create("TextButton", PageTools, {
        BackgroundColor3 = Color3.fromRGB(45, 45, 45),
        Text = displayName,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 16, 
        Font = Enum.Font.LuckiestGuy, 
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center
    })
    Create("UICorner", btn, {CornerRadius = UDim.new(0, 2)})

    if data.link ~= "" then
        btn.encryptedName = data.name
        btn.encryptedLink = data.link
        
        btn.MouseButton1Click:Connect(function()
            _executeScript(btn.encryptedName, btn.encryptedLink)
        end)
    else
        btn.AutoButtonColor = false
    end
end

