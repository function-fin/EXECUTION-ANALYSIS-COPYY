        MiniTextBox.TextColor3 = Color3.fromRGB(255, 50, 50)
        task.wait(1.5)
        MiniTextBox.Text = ""
        MiniTextBox.TextColor3 = Color3.fromRGB(0, 0, 0)
    end
end)

MiniTextBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        JoinLinkBtn.MouseButton1Click:Fire()
    end
end)

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Escape then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

