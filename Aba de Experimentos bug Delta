local function encryptCaesar(text, key)
    local result = {}
    for i = 1, #text do
        local byte = text:byte(i)
        -- Desloca mantendo o limite de bytes (0-255)
        local encryptedByte = (byte + key) % 256
        table.insert(result, string.format("\\%d", encryptedByte))
    end
    return table.concat(result)
end

